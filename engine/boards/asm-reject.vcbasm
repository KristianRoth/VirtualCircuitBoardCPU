symbol one 1
symbol two 2
symbol four 4
symbol six 6
macro pair { a? | b? }

# case o-orgprev-nothing-to-revert
origin orgprev; @ OE1; OE1

# case o-orgbase-nothing-to-revert
origin orgbase; @ OE2; OE2

# case b-wider-than-32-bits
origin 0x1020; 0xB502; 0x1_0000_0000

# case d-symbol-twice
symbol d1 1; symbol d1 2; origin 0x1030; 0xB503; d1

# case d-pointer-twice
pointer d2 0x1048 1; pointer d2 0x1049 2; origin 0x1040; 0xB504; d2

# case d-macro-twice
macro d3 { a? | b? }; macro d3 { a? | b? | four }; origin 0x1050; 0xB505; d3 one two

# case d-label-twice
origin 0x1060; 0xB506; @ D4; 1; @ D4; 2; D4

# case e-symbol-and-pointer
symbol e1 1; pointer e1 0x1078 2; origin 0x1070; 0xB507; e1

# case e-symbol-and-label
symbol e2 1; origin 0x1080; 0xB508; @ e2; 5; e2

# case e-keyword-as-name
symbol sub_bookmark 1; origin 0x1090; 0xB509; 5

# case f-undefined-name
origin 0x10A0; 0xB50A; nope_f1

# case f-after-unsymb
symbol f2 1; unsymb f2; origin 0x10B0; 0xB50B; f2

# case f-after-unpoint
pointer f3 0x10C8 1; unpoint f3; origin 0x10C0; 0xB50C; f3

# case g-symbol-before-definition
origin 0x10D0; 0xB50D; g1; symbol g1 5

# case g-pointer-before-definition
origin 0x10E0; 0xB50E; g2; pointer g2 0x10E8 5

# case h-fewer-arguments
origin 0x10F0; 0xB50F; pair one

# case h-more-arguments
origin 0x1100; 0xB510; pair one two four

# case i-expression-argument
origin 0x1110; 0xB511; pair (one | two) four

# case j-macro-among-primitives
origin 0x1120; 0xB512; one pair

# case k-multi-line-macro
macro k1 {
a? | b?
}
origin 0x1130; 0xB513; k1 one two

# case n-beyond-address-bits
origin 0x10000; 0xB514

# case p-symbol-value-is-a-name
symbol p1 one; origin 0x1150; 0xB515; p1

# case p-symbol-value-is-an-expression
symbol p2 1 + 1; origin 0x1160; 0xB516; p2

# case p-operator-without-spaces
origin 0x1170; 0xB517; 1|2

# case q-label-and-instruction
origin 0x1180; 0xB518; @ Q1 5

# case q-keyword-upper-case
Symbol q2 1; origin 0x1190; 0xB519; 5

# case q-prefix-upper-case
origin 0x11A0; 0xB51A; 0X10

# case q-plus-sign
origin 0x11B0; 0xB51B; +5

# case v-repoint
pointer v1 0x11C8 7; repoint v1 0x11C9 8; origin 0x11C0; 0xB51C; v1

# case x-dot-in-name
symbol x.1 1; origin 0x11D0; 0xB51D; 5

# case x-name-starts-with-digit
symbol 1x 1; origin 0x11E0; 0xB51E; 5

# case z-primitives-beside-expression
origin 0x11F0; 0xB51F; 1 2 | 4

# case z-unclosed-parenthesis
origin 0x1200; 0xB520; (1

# case z-resymb-of-new-name
resymb zr1 1; origin 0x1210; 0xB521; zr1

# case c-divide-by-zero
origin 0x1220; 0xB522; 6 / 0

# case c-modulo-by-zero
origin 0x1230; 0xB523; 6 % 0

# case c-shift-by-32
origin 0x1240; 0xB524; 1 << 32

# case c-shift-by-1000
origin 0x1250; 0xB525; 1 << 1000

# case k-macro-in-macro
macro k2 { pair | a? | b? }; origin 0x1260; 0xB526; k2 one two

# case s-label-at-end
@ S_END

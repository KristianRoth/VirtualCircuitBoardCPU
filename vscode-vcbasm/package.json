{
  "name": "vcbasm",
  "displayName": "VCB Assembly",
  "description": "Syntax colouring for Virtual Circuit Board assembly files (.vcbasm)",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "vcbasm",
        "aliases": ["VCB Assembly", "vcbasm"],
        "extensions": [".vcbasm"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vcbasm",
        "scopeName": "source.vcbasm",
        "path": "./syntaxes/vcbasm.tmLanguage.json"
      }
    ]
  }
}
